#!/bin/bash
# startup_script.sh.tftpl
# Parameterized master startup script for all CPU and TPU runners.
set -e

echo "=== Starting unified VM initialization ==="

# 1. Base packages installation
apt-get update
apt-get install -y curl build-essential jq git python3 python3-pip python3-venv software-properties-common

# Install python packages required for the Git credential helper
pip3 install pyjwt requests cryptography --break-system-packages || pip3 install pyjwt requests cryptography

# 2. Install Docker
if ! command -v docker &> /dev/null; then
  echo "Installing Docker..."
  curl -fsSL https://get.docker.com | bash
fi

# 3. Install Rust and Minijinja
if ! command -v minijinja-cli &> /dev/null; then
  echo "Installing Rust & Minijinja..."
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
  /root/.cargo/bin/cargo install minijinja-cli
  cp /root/.cargo/bin/minijinja-cli /usr/bin/minijinja-cli
  chmod 755 /usr/bin/minijinja-cli
fi

# 4. Install Buildkite CLI & Agent
if ! command -v buildkite-agent &> /dev/null; then
  echo "Installing Buildkite Agent..."
  # Buildkite CLI
  curl -fsSL "https://packages.buildkite.com/buildkite/cli-deb/gpgkey" | gpg --dearmor --yes -o /usr/share/keyrings/buildkite_cli-deb-archive-keyring.gpg
  echo -e "deb [signed-by=/usr/share/keyrings/buildkite_cli-deb-archive-keyring.gpg] https://packages.buildkite.com/buildkite/cli-deb/any/ any main\ndeb-src [signed-by=/usr/share/keyrings/buildkite_cli-deb-archive-keyring.gpg] https://packages.buildkite.com/buildkite/cli-deb/any/ any main" | tee /etc/apt/sources.list.d/buildkite-buildkite-cli-deb.list

  # Buildkite Agent
  curl -fsSL https://keys.openpgp.org/vks/v1/by-fingerprint/32A37959C2FA5C3C99EFBC32A79206696452D198 | gpg --dearmor --yes -o /usr/share/keyrings/buildkite-agent-archive-keyring.gpg
  echo "deb [signed-by=/usr/share/keyrings/buildkite-agent-archive-keyring.gpg] https://apt.buildkite.com/buildkite-agent stable main" | tee /etc/apt/sources.list.d/buildkite-agent.list

  apt-get update
  apt-get install -y bk buildkite-agent
fi

# Force stop agent to prevent race conditions during configuration
systemctl stop buildkite-agent || true

# 5. Conditionally Format and Mount Secondary Storage Disk
%{ if mount_disk }
DISK_DEV="${disk_device}"
if [ -n "$DISK_DEV" ] && [ -b "$DISK_DEV" ]; then
  echo "Secondary disk $DISK_DEV detected. Formatting and mounting..."
  sudo mkdir -p /mnt/disks/persist
  if ! blkid "$DISK_DEV"; then
    echo "Formatting $DISK_DEV as ext4..."
    sudo mkfs.ext4 -m 0 -E lazy_itable_init=0,lazy_journal_init=0,discard "$DISK_DEV"
  fi
  
  # Mount to path
  if ! mountpoint -q /mnt/disks/persist; then
    sudo mount -o discard,defaults "$DISK_DEV" /mnt/disks/persist
  fi

  # Add to fstab
  disk_uuid=$(blkid -s UUID -o value "$DISK_DEV")
  if ! grep -q "/mnt/disks/persist" /etc/fstab; then
    echo "UUID=$disk_uuid /mnt/disks/persist ext4 defaults,discard 0 2" | sudo tee -a /etc/fstab
  fi

  # Configure Docker data-root
  if [ -f /etc/docker/daemon.json ]; then
    jq '. + {"data-root": "/mnt/disks/persist"}' /etc/docker/daemon.json > /tmp/daemon.json.tmp && mv /tmp/daemon.json.tmp /etc/docker/daemon.json
  else
    mkdir -p /etc/docker
    echo '{"data-root": "/mnt/disks/persist"}' | tee /etc/docker/daemon.json
  fi
  
  # Allow full permission to persist folder
  chmod 777 /mnt/disks/persist
else
  echo "WARNING: secondary disk $DISK_DEV requested but not found!"
fi
%{ endif }

# Docker daemon reload
systemctl daemon-reload || true
systemctl start docker || true

# 6. Configure Git Credential Helper for GitHub App Auth
cat <<'EOF' > /usr/local/bin/git-credential-github-app
#!/usr/bin/env python3
import sys, os, time, subprocess, requests, jwt

def get_pem_key():
    try:
        res = subprocess.run(
            ["/usr/local/bin/get-github-app-pem"], 
            capture_output=True, text=True, check=True, timeout=5
        )
        return res.stdout.strip()
    except Exception as e:
        sys.stderr.write(f"Fetch script error: {e}\n")
        return None

def main():
    inputs = {}
    for line in sys.stdin:
        line = line.strip()
        if not line: break
        if '=' in line:
            k, v = line.split('=', 1)
            inputs[k] = v

    action = sys.argv[1] if len(sys.argv) > 1 else ""
    if action != "get" or inputs.get("host") != "github.com":
        return

    pem_key = get_pem_key()
    if not pem_key:
        return

    APP_ID = "4156238"
    INSTALLATION_ID = "142868369"
    
    try:
        signing_key = pem_key.encode('utf-8')
        payload = { 'iat': int(time.time()) - 10, 'exp': int(time.time()) + 600, 'iss': APP_ID }
        encoded_jwt = jwt.encode(payload, signing_key, algorithm='RS256')

        response = requests.post(
            f'https://api.github.com/app/installations/{INSTALLATION_ID}/access_tokens',
            headers={'Authorization': f'Bearer {encoded_jwt}', 'Accept': 'application/vnd.github.v3+json'},
            timeout=10
        )
        response.raise_for_status()
        token = response.json()['token']

        print("username=x-access-token")
        print(f"password={token}")
    except Exception as e:
        sys.stderr.write(f"GitHub App auth helper error: {e}\n")

if __name__ == "__main__":
    main()
EOF

chmod +x /usr/local/bin/git-credential-github-app

# Create the custom fetch script
cat <<EOF > /usr/local/bin/get-github-app-pem
#!/bin/bash
exec buildkite-agent secret get ${github_app_secret_name}
EOF
chmod +x /usr/local/bin/get-github-app-pem

# Register the helper and redirect system-wide
git config --system url."https://github.com/".insteadOf "git@github.com:"
git config --system credential.https://github.com.helper github-app

# 7. Configure Buildkite Agent
usermod -a -G docker buildkite-agent || true
sudo -u buildkite-agent gcloud auth configure-docker us-central1-docker.pkg.dev --quiet || true
sudo -u buildkite-agent gcloud auth configure-docker us-docker.pkg.dev --quiet || true

# Token config
sed -i "s/xxx/${buildkite_token}/g" /etc/buildkite-agent/buildkite-agent.cfg
sed -i "s/name=\"%hostname-%spawn\"/name=\"${hostname}\"/" /etc/buildkite-agent/buildkite-agent.cfg

# Add tags
grep -q 'tags=' /etc/buildkite-agent/buildkite-agent.cfg || echo 'tags="${buildkite_tags}"' | tee -a /etc/buildkite-agent/buildkite-agent.cfg

# Add environment variables
grep -q "HF_TOKEN=" /etc/environment || echo 'HF_TOKEN=${huggingface_token}' | tee -a /etc/environment
%{ if buildkite_analytics_token != "" }
grep -q "BUILDKITE_ANALYTICS_TOKEN=" /etc/environment || echo 'BUILDKITE_ANALYTICS_TOKEN=${buildkite_analytics_token}' | tee -a /etc/environment
%{ endif }
%{ if tpu_version != "" }
grep -q "TPU_VERSION=" /etc/environment || echo 'TPU_VERSION=${tpu_version}' | tee -a /etc/environment
%{ endif }

# 8. Setup Ops Agent
%{ if enable_ops_agent }
if ! systemctl is-active --quiet google-cloud-ops-agent; then
  echo "Installing GCP Ops Agent..."
  curl -sSO https://dl.google.com/cloudagents/add-google-cloud-ops-agent-repo.sh
  bash add-google-cloud-ops-agent-repo.sh --also-install
fi
%{ endif }

# 9. Syslog logrotate policy
sed -i '1i/var/log/syslog\n/var/log/kern.log\n{\n  size 50M\n  rotate 1\n  missingok\n  notifempty\n  compress\n  delaycompress\n  postrotate\n    /usr/lib/rsyslog/rsyslog-rotate\n  endscript\n}\n' /etc/logrotate.d/rsyslog || true

# 10. TPU JAX Cache Symlink & Cleanups
%{ if tpu_version != "" }
echo "Configuring JAX Cache symlinks..."
sudo mkdir -p /mnt/disks/persist/tpu_jax_cache
sudo chmod 777 /mnt/disks/persist/tpu_jax_cache
sudo rm -rf /tmp/tpu_jax_cache
sudo ln -s /mnt/disks/persist/tpu_jax_cache /tmp/tpu_jax_cache

# Register daily cron for JAX cache cleanup of files older than 7 days
if ! crontab -l | grep -q "tpu_jax_cache"; then
  (crontab -l 2>/dev/null; echo "0 0 * * * find /mnt/disks/persist/tpu_jax_cache -type f -mtime +7 -delete") | crontab -
fi
%{ endif }

# 11. Start Buildkite Agent
systemctl daemon-reload
systemctl enable buildkite-agent
systemctl start buildkite-agent

echo "=== VM Initialization completed successfully ==="
